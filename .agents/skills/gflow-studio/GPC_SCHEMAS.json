    "policy": "TWO_GATE_LOW_FRICTION",
    "question_delivery": "SELECTABLE_OPTIONS_MODAL_VIA_ASK_QUESTION",
    "gates": [
      {
        "gate_id": "GATE_1_INITIAL_SETUP_AND_STORY",
        "when": "Beginning of project (Modules 00-01)",
        "blocks": "Autonomous execution of Modules 02-07"
      },
      {
        "gate_id": "GATE_2_EXCEPTION_ONLY_ESCALATION",
        "when": "Only on unrecoverable video generation/QA blocker after 2 automatic self-heal attempts (Module 06)",
        "blocks": "Affected shot or credit/policy resolution"
      }
    ]
  },
